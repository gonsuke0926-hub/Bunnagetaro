<UserControl x:Class="Bunnagetaro5.Views.Drawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- メニュー（☰）: 右端から幅280が180msでスライド。
         出ている間はパネル以外に黒の不透明度0.2。そこを押すと閉じる。Escでも閉じる -->
    <Grid x:Name="DrawerLayer" Visibility="Collapsed">
        <Rectangle x:Name="Scrim" Fill="{StaticResource Scrim}" MouseLeftButtonUp="Scrim_Click"/>
        <Border x:Name="DrawerPanel" HorizontalAlignment="Right" Width="280"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerX" X="280"/>
            </Border.RenderTransform>
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="10,10,4,6">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="メニュー"
                                   Style="{StaticResource SectionHeading}"
                                   Margin="10,0,0,0"/>
                        <Button x:Name="DrawerCloseButton" DockPanel.Dock="Right"
                                Style="{StaticResource IconButton}"
                                FontSize="13" Padding="10,6" Content="&#xE700;"
                                Click="DrawerClose_Click"/>
                    </DockPanel>
                </Border>
                <StackPanel>
                    <!-- 項目: 左にアイコン、右に文字、高さ40。今のページは左端にAccentの縦線（幅3） -->
                    <Border x:Name="ItemLog" Style="{StaticResource DrawerItem}"
                            Tag="log" MouseLeftButtonUp="DrawerItem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="MarkLog" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                            <TextBlock x:Name="IconLog" Grid.Column="1" Tag="icon" Style="{StaticResource Icon}"
                                       Text="&#xE8FD;" Margin="12,0,6,0"/>
                            <TextBlock Grid.Column="2" Text="ログ" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </Border>
                    <Border x:Name="ItemCfg" Style="{StaticResource DrawerItem}"
                            Tag="cfg" MouseLeftButtonUp="DrawerItem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="MarkCfg" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                            <TextBlock x:Name="IconCfg" Grid.Column="1" Tag="icon" Style="{StaticResource Icon}"
                                       Text="&#xE713;" Margin="12,0,6,0"/>
                            <TextBlock Grid.Column="2" Text="設定" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </Border>
                    <Border x:Name="ItemHelp" Style="{StaticResource DrawerItem}"
                            Tag="help" MouseLeftButtonUp="DrawerItem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="MarkHelp" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                            <TextBlock x:Name="IconHelp" Grid.Column="1" Tag="icon" Style="{StaticResource Icon}"
                                       Text="&#xE897;" Margin="12,0,6,0"/>
                            <TextBlock Grid.Column="2" Text="使い方" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </Border>
                    <!-- 区切り線 -->
                    <Border Height="1" Background="{StaticResource Border}" Margin="16,6"/>
                    <Border x:Name="ItemFolder" Style="{StaticResource DrawerItem}"
                            Tag="folder" MouseLeftButtonUp="DrawerItem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IconFolder" Grid.Column="1" Tag="icon" Style="{StaticResource Icon}"
                                       Text="&#xE8B7;" Margin="12,0,6,0"/>
                            <TextBlock Grid.Column="2" Text="ログのフォルダを開く" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </Border>
                    <Border x:Name="ItemAbout" Style="{StaticResource DrawerItem}"
                            Tag="about" MouseLeftButtonUp="DrawerItem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IconAbout" Grid.Column="1" Tag="icon" Style="{StaticResource Icon}"
                                       Text="&#xE946;" Margin="12,0,6,0"/>
                            <TextBlock Grid.Column="2" Text="バージョン情報" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
