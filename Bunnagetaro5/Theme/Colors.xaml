<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 色トークン。ここ以外で色を直接書かない（例外: overlay_bg / overlay_fg） -->
    <Color x:Key="BgColor">#F3F3F3</Color>
    <Color x:Key="NavBgColor">#EAEAEA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SubtleSurfaceColor">#F8F8F8</Color>
    <Color x:Key="SegTrackColor">#EFEFEF</Color>
    <Color x:Key="SurfaceHoverColor">#F5F5F5</Color>
    <Color x:Key="DividerColor">#ECECEC</Color>
    <Color x:Key="BorderColor">#E3E3E3</Color>
    <Color x:Key="BorderStrongColor">#CFCFCF</Color>
    <Color x:Key="TextColor">#1B1B1B</Color>
    <Color x:Key="SubtleColor">#616161</Color>
    <Color x:Key="DisabledColor">#A0A0A0</Color>
    <Color x:Key="AccentColor">#0067C0</Color>
    <Color x:Key="AccentHoverColor">#1975C5</Color>
    <Color x:Key="AccentPressColor">#3283CB</Color>
    <!-- 主ボタン用の淡い青。AccentColor は据え置き（チェック欄などが使う） -->
    <Color x:Key="AccentSoftColor">#D6E8F8</Color>
    <Color x:Key="AccentSoftHoverColor">#C6DEF5</Color>
    <Color x:Key="AccentSoftPressColor">#B5D3F1</Color>
    <Color x:Key="AccentSoftBorderColor">#A8CBEE</Color>
    <Color x:Key="AccentSoftTextColor">#00467F</Color>
    <Color x:Key="DangerColor">#C42B1C</Color>
    <Color x:Key="DangerSoftColor">#FDE7E9</Color>
    <Color x:Key="DangerSoftHoverColor">#FAD4D8</Color>
    <Color x:Key="DangerSoftBorderColor">#F1B8BE</Color>
    <Color x:Key="WarningColor">#9D5D00</Color>
    <Color x:Key="BarBgColor">#F9F9F9</Color>
    <Color x:Key="ScrimColor">#33000000</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="NavBg" Color="{StaticResource NavBgColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SubtleSurface" Color="{StaticResource SubtleSurfaceColor}"/>
    <SolidColorBrush x:Key="SegTrack" Color="{StaticResource SegTrackColor}"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="Divider" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Subtle" Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="Disabled" Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPress" Color="{StaticResource AccentPressColor}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentSoftHover" Color="{StaticResource AccentSoftHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftPress" Color="{StaticResource AccentSoftPressColor}"/>
    <SolidColorBrush x:Key="AccentSoftBorder" Color="{StaticResource AccentSoftBorderColor}"/>
    <SolidColorBrush x:Key="AccentSoftText" Color="{StaticResource AccentSoftTextColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="DangerSoftHover" Color="{StaticResource DangerSoftHoverColor}"/>
    <SolidColorBrush x:Key="DangerSoftBorder" Color="{StaticResource DangerSoftBorderColor}"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="BarBg" Color="{StaticResource BarBgColor}"/>
    <SolidColorBrush x:Key="Scrim" Color="{StaticResource ScrimColor}"/>

    <!-- フォント -->
    <FontFamily x:Key="UiFont">Yu Gothic UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
