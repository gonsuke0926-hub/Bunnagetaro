<UserControl x:Class="Bunnagetaro5.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Bunnagetaro5.Pages"
             xmlns:views="clr-namespace:Bunnagetaro5.Views"
             Background="{StaticResource Bg}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 履歴カード -->
        <DataTemplate DataType="{x:Type pages:LogCardVm}">
            <Border Style="{StaticResource Card}" Margin="6,4">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="答えをすべてコピー" Click="CopyText_Click"
                                  IsEnabled="{Binding CopyEnabled}"/>
                        <MenuItem Header="スクショをコピー" Click="CopyImage_Click"
                                  IsEnabled="{Binding HasImageFile}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1行目: ts  model  (手動)  ［✗ぶん投げ失敗］ -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SubtleText}" Text="{Binding Header}"/>
                        <TextBlock Style="{StaticResource SubtleText}" Text="  ✗ぶん投げ失敗"
                                   Foreground="{StaticResource Danger}"
                                   Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource SubtleText}" Text="  ぶん投げ中…"
                                   Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- 2行目: 左サムネイル / 右本文（コピーボタンは無くし、右クリックでコピー） -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="4"
                                ClipToBounds="True" Cursor="Hand" VerticalAlignment="Top"
                                MaxHeight="{Binding BodyHeight}"
                                Background="{StaticResource SurfaceHover}"
                                MouseLeftButtonUp="Thumb_Click">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="スクショをコピー" Click="CopyImage_Click"
                                              IsEnabled="{Binding HasImageFile}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <TextBlock Text="{Binding ThumbText}" TextAlignment="Center"
                                           Style="{StaticResource SubtleText}"
                                           Margin="8" VerticalAlignment="Center"/>
                                <Image Source="{Binding ThumbSource}" Stretch="Uniform"
                                       MaxWidth="180" MaxHeight="{Binding BodyHeight}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <!-- 本文は解答欄と同じ AnswerView（式は画像・段落の間・行間）。色はログの画面に合わせ、
                             高さは中身に伸びる。選択してコピーできる -->
                        <!-- たたんでいる間は 10 行分の高さにそろえる（はみ出しは切って下を薄く、押すと開く） -->
                        <Grid Grid.Column="1" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <pages:LogClipBox x:Name="Clip" Grid.Row="0"
                                              BodyHeight="{Binding BodyHeight}"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                <views:AnswerView LogMode="True"
                                                  LogText="{Binding Body, Mode=OneWay}"
                                                  LogCopyEnabled="{Binding CopyEnabled, Mode=OneWay}"
                                                  VerticalAlignment="Top"/>
                            </pages:LogClipBox>
                            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="44" Cursor="Hand"
                                    MouseLeftButtonUp="Expand_Click"
                                    Visibility="{Binding ShowMore, ElementName=Clip, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#00FFFFFF"/>
                                        <GradientStop Offset="0.6" Color="{StaticResource SurfaceColor}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="▼ 続きを表示" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                            </Border>
                            <Button Grid.Row="1" Content="▲ たたむ" HorizontalAlignment="Right" Margin="0,6,0,0" Padding="10,2"
                                    Click="Collapse_Click"
                                    Visibility="{Binding ShowLess, ElementName=Clip, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- VirtualizingStackPanel + ScrollUnit=Pixel。仮想化を効かせるには
             CanContentScroll=True が必須（False だと仮想化が無効になり全カードが常に実体化される）。
             ピクセル単位のスクロールは VirtualizingPanel.ScrollUnit="Pixel" で得る -->
        <ListBox x:Name="Lst" ItemsSource="{Binding}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <TextBlock x:Name="EmptyText" Text="まだログはありません"
                   Style="{StaticResource SubtleText}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
